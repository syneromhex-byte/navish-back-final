# =============================================================================
# NAVISH ARC — Environment Variables Reference
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development                      # development | production | test
PORT=3000
API_VERSION=v1
APP_NAME="NAVISH ARC"
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://navish:Navish123@localhost:5432/navish_arc?schema=public"

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=your-super-secret-access-token-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=365d
JWT_REFRESH_EXPIRES_IN=365d
JWT_RESET_EXPIRES_IN=1h

# -----------------------------------------------------------------------------
# AWS S3
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=navish-arc-assets-2026
AWS_S3_ENDPOINT=                          # Leave empty for real AWS, set for MinIO

# MinIO (local dev S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=navish-arc-local

# -----------------------------------------------------------------------------
# Email (AWS SES)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=ses                        # ses | smtp
EMAIL_FROM="NAVISH ARC <no-reply@navish.com>"
EMAIL_FROM_NAME="NAVISH ARC"

# AWS SES (uses AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
SES_REGION=us-east-1

# SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000               # 15 minutes
RATE_LIMIT_MAX=100
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# File Upload
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=500
ALLOWED_MODEL_TYPES=glb,gltf,fbx,obj,skp,3ds
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp,hdr,exr
ALLOWED_TEXTURE_TYPES=jpg,jpeg,png,webp,ktx2,basis
LOCAL_STORAGE_PATH=./storage
MULTIPART_THRESHOLD_MB=10                 # Files above this use S3 multipart

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug                           # error | warn | info | http | debug
LOG_DIR=./src/logs

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_URL=http://localhost:5173/reset-password
EMAIL_VERIFY_URL=http://localhost:5173/verify-email
